{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://3.37.55.120.nip.io:8080/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:path*/:slug*",
      "destination": "/index.html"
    }
  ]
}